### list default
GET http://127.0.0.1:8080/monitor/job/list

### list search by keyword
GET http://127.0.0.1:8080/monitor/job/list?keyword=任务

### list search by status = 1
GET http://127.0.0.1:8080/monitor/job/list?status=1

### list search by status = 0
GET http://127.0.0.1:8080/monitor/job/list?status=0

### list search by name
GET http://127.0.0.1:8080/monitor/job/list?name=任务名称

### list search by group
GET http://127.0.0.1:8080/monitor/job/list?group=default

### list search by id
GET http://127.0.0.1:8080/monitor/job/list?id=1

### create empty
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json

{
}

### create empty name
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json

{
  "invoke_target": "demoTask.noParams()",
  "name": ""
}

### create empty invoke_target
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json

{
  "name": "job-name-1",
  "invoke_target": ""
}

### create success
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json

{
  "name": "job-name-1",
  "invoke_target": "demoTask.noParams()"
}

### create success 1
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json

{
  "name": "job-name-2",
  "group": "default",
  "invoke_target": "demoTask.params('demo')",
  "cron_expression": "0/5 * * * * ?",
  "status": 1
}

### create with exitst name
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json

{
  "name": "job-name-1",
  "invoke_target": "demoTask.multipleParams('demo', true, 2000, 1.0)"
}

### update empty
PUT http://127.0.0.1:8080/monitor/job/update
content-type: application/json

{
}

### update empty id
PUT http://127.0.0.1:8080/monitor/job/update
content-type: application/json

{
  "id": 0,
  "name": "定时任务",
  "invoke_target": "demoTask.noParams()"
}

### update empty name
PUT http://127.0.0.1:8080/monitor/job/update
content-type: application/json

{
  "id": 1,
  "invoke_target": "demoTask.noParams()",
  "name": ""
}

### update success
PUT http://127.0.0.1:8080/monitor/job/update
content-type: application/json

{
  "id": 1,
  "name": "job-name-111",
  "group": "default",
  "invoke_target": "demoTask.noParams()",
  "cron_expression": "0/10 * * * * ?",
  "status": 0
}

### detail empty
GET http://127.0.0.1:8080/monitor/job/detail

### detail empty id
GET http://127.0.0.1:8080/monitor/job/detail?id=

### detail not exist data
GET http://127.0.0.1:8080/monitor/job/detail?id=99999

### detail success
GET http://127.0.0.1:8080/monitor/job/detail?id=1

### delete empty
DELETE http://127.0.0.1:8080/monitor/job/delete
content-type: application/json

{
}

### delete empty ids
DELETE http://127.0.0.1:8080/monitor/job/delete
content-type: application/json

{
  "ids": []
}

### delete success
DELETE http://127.0.0.1:8080/monitor/job/delete
content-type: application/json

{
  "ids": [2]
}

### check delete
GET http://127.0.0.1:8080/monitor/job/detail?id=2

### change-status
PUT http://127.0.0.1:8080/monitor/job/change-status
content-type: application/json

{
  "id": 1,
  "status": 1
}

### check-name
GET http://127.0.0.1:8080/monitor/job/check-name?name=demoTask

### ===== 定时任务调度 =====
# 说明：以下用例需先在本文件中执行上面的 login 用例获取令牌（AUTH_ENABLED=true 时）

### 登录获取令牌（本文件内使用）
# @name jobLogin
POST http://127.0.0.1:8080/login
content-type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### 新增任务：销毁性 cron 非法（预期 cron 表达式错误）
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json
Authorization: Bearer {{jobLogin.response.body.$.data.token}}

{
  "name": "非法cron任务",
  "group": "default",
  "executor": "default",
  "invoke_target": "demoTask.noParams()",
  "cron_expression": "0 0 0 * *",
  "misfire_policy": "3",
  "concurrent": "1",
  "status": 1
}

### 新增任务：调用目标未注册（预期调用目标字符串错误）
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json
Authorization: Bearer {{jobLogin.response.body.$.data.token}}

{
  "name": "非法调用目标任务",
  "group": "default",
  "executor": "default",
  "invoke_target": "evil.exec('rm -rf /')",
  "cron_expression": "0 0 1 * * ?",
  "misfire_policy": "3",
  "concurrent": "1",
  "status": 1
}

### 新增任务：每 2 秒执行一次（状态 0 正常，创建后即参与调度）
POST http://127.0.0.1:8080/monitor/job/create
content-type: application/json
Authorization: Bearer {{jobLogin.response.body.$.data.token}}

{
  "name": "调度演示任务",
  "group": "default",
  "executor": "default",
  "invoke_target": "demoTask.multipleParams('demo', true, 2000, 1.0)",
  "job_args": "hello|2000",
  "job_kwargs": "",
  "cron_expression": "*/2 * * * * ?",
  "misfire_policy": "1",
  "concurrent": "1",
  "status": 0,
  "remark": "每 2 秒执行一次，演示自动调度"
}

### 立即执行一次（状态为暂停的任务同样可以执行）
PUT http://127.0.0.1:8080/monitor/job/run
content-type: application/json
Authorization: Bearer {{jobLogin.response.body.$.data.token}}

{
  "id": 4
}

### 暂停任务（状态 1 暂停后不再自动触发）
PUT http://127.0.0.1:8080/monitor/job/change-status
content-type: application/json
Authorization: Bearer {{jobLogin.response.body.$.data.token}}

{
  "id": 4,
  "status": 1
}

### 启用任务（状态 0 正常，重新参与调度）
PUT http://127.0.0.1:8080/monitor/job/change-status
content-type: application/json
Authorization: Bearer {{jobLogin.response.body.$.data.token}}

{
  "id": 4,
  "status": 0
}

### 任务执行日志（验证 sys_job_log 是否写入）
GET http://127.0.0.1:8080/system/job-log/list?pageSize=10&job_name=调度演示任务
Authorization: Bearer {{jobLogin.response.body.$.data.token}}
