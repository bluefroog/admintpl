package domain

import (
{{- if .ImportTime}}
	"time"
{{- end}}

	"{{.PackageName}}/common/model/request"{{if .UseAuditModel}}
	"{{.PackageName}}/common/model/core"{{end}}
)

// {{.ClassName}} {{.FunctionName}} model
// 由代码生成器生成（表 {{.TableName}}），请按业务需要补充唯一性校验与关联清理逻辑
type {{.ClassName}} struct {
	ID uint `json:"id" form:"id" gorm:"column:{{.Pk.ColumnName}};type:{{.Pk.ColumnType}}{{if eq .Pk.IsIncrement "1"}} auto_increment{{end}};primary_key;not null;comment:{{.Pk.Comment}}"` // {{.Pk.Comment}}

	{{.ClassName}}Base
}

// TableName 指定表名
func (m *{{.ClassName}}) TableName() string {
	return "{{.TableName}}"
}

// {{.ClassName}}Base {{.FunctionName}}基础结构
type {{.ClassName}}Base struct {
{{- range .Fields}}
	{{.GoField}} {{.GoTypeDecl}} `json:"{{.ColumnName}}" form:"{{.ColumnName}}"{{if and (eq .IsRequired "1") (eq .GoTypeDecl "string")}} validate:"required"{{end}} gorm:"column:{{.ColumnName}};type:{{.ColumnType}}{{if eq .IsRequired "1"}};not null{{end}};comment:{{.Comment}}"` // {{.Comment}}
{{- end}}
{{- if .UseAuditModel}}

	core.AuditModel
{{- end}}
}

// {{.ClassName}}SearchRequest {{.FunctionName}}搜索请求结构体
type {{.ClassName}}SearchRequest struct {
	request.PageInfo
	request.SortInfo
{{- if .KeyField}}

	Keyword string `json:"keyword" form:"keyword"` // 关键字（模糊匹配 {{range $i, $f := .KeyField}}{{if $i}}/{{end}}{{$f.Comment}}{{end}}）
{{- end}}

	ID *uint `json:"id" form:"id"` // 主键
{{- range .QueryField}}
{{- if .IsRange}}
	Begin{{.GoField}} string `json:"begin_{{.ColumnName}}" form:"begin_{{.ColumnName}}"` // {{.Comment}}（起始）
	End{{.GoField}} string `json:"end_{{.ColumnName}}" form:"end_{{.ColumnName}}"` // {{.Comment}}（结束）
{{- else}}
	{{.GoField}} {{.SearchType}} `json:"{{.ColumnName}}" form:"{{.ColumnName}}"` // {{.Comment}}
{{- end}}
{{- end}}

	IDNotIn []uint `json:"idNotIn"` // 不包含的主键列表
	IDIn    []uint `json:"idIn"`    // 包含的主键列表
{{- if .UseAuditModel}}

	core.AuditSearchRequest
{{- end}}
}

// {{.ClassName}}CreateRequest {{.FunctionName}}添加请求结构体
type {{.ClassName}}CreateRequest struct {
	{{.ClassName}}Base
}

// {{.ClassName}}UpdateRequest {{.FunctionName}}编辑请求结构体
type {{.ClassName}}UpdateRequest struct {
	request.GetById
	{{.ClassName}}Base
}
