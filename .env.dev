# ─────────────────────────────────────────────────────────────
# 开发环境配置（dev）
# 使用方式：just env dev   （将本文件复制为 .env，.env 不入库）
# 说明：值中不要写行内注释；系统环境变量优先级高于本文件
# ─────────────────────────────────────────────────────────────

# ---- 服务 ----
SERVICE_PORT=:8080
SERVICE_DEBUG=true

# ---- 数据库 ----
DB_TYPE=mysql
DB_DSN=root:123456@tcp(192.168.122.129:3306)/ruoyi?charset=utf8mb4&parseTime=True&loc=Local
DB_PREFIX=
DB_MAX_IDLE=10
DB_MAX_OPEN=10
DB_MAX_LIFETIME=30
DB_DEBUG=true

# ---- 登录认证 ----
AUTH_ENABLED=true
AUTH_TOKEN_EXPIRE=720
AUTH_MAX_RETRY=5
AUTH_LOCK_TIME=10
AUTH_PERMISSION_ENABLED=false

# ---- 图形验证码 ----
CAPTCHA_ENABLED=false
CAPTCHA_LENGTH=4
CAPTCHA_EXPIRE=120

# ---- 基础数据初始化（首次启动写入内置数据） ----
SEED_ENABLED=true

# ---- 定时任务调度 ----
JOB_ENABLED=true
JOB_LOG_RETAIN_DAYS=30

# ---- 数据权限 ----
DATA_SCOPE_ENABLED=true
# 参数 / 字典缓存（关闭后每次查询回源数据库，仅建议排查问题时使用）
CACHE_ENABLED=true
