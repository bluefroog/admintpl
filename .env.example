# ─────────────────────────────────────────────────────────────
# 环境变量参考（示例）—— 展示全部环境变量与说明
#   使用方式：
#     1) 复制为 .env（.env 不入库）：cp .env.example .env
#     2) 或将需要的变量注入容器/操作系统环境（优先级更高）
#     3) 也可用 just env dev / just env pro 切换预置环境
#   注意：值中不要写行内注释；# 开头的整行才是注释；空值表示「使用 config.yaml 中的默认值」
# ─────────────────────────────────────────────────────────────

# ---- 运行期变量（不属于配置项） ----
# .env 文件路径（默认 .env）
ENV_FILE=.env
# 配置文件名（默认 config，即 ./config/config.yaml）
CONFIG_NAME=config

# ---- 配置加密（AES-256-GCM / 国密 SM4-CBC） ----
# 生成密文：just encrypt 'root:123456@tcp(127.0.0.1:3306)/admintpl?charset=utf8mb4&parseTime=True&loc=Local'
# 指定算法：just encrypt '明文' SM4
# 开启后 DB_DSN、CACHE_REDIS_PASSWORD 等敏感值可写成 ENC(...)；密钥必须与部署环境一致
CONFIG_ENCRYPT_ENABLED=false
CONFIG_SECRET_ALGORITHM=AES
CONFIG_SECRET_KEY=

# ---- 服务 ----
SERVICE_PORT=:8080
SERVICE_DEBUG=true

# ---- 数据库 ----
DB_DEFAULT=admin
DB_TYPE=mysql
DB_DSN=root:123456@tcp(127.0.0.1:3306)/admintpl?charset=utf8mb4&parseTime=True&loc=Local
DB_PREFIX=
DB_SINGULAR=true
DB_MAX_IDLE=10
DB_MAX_OPEN=10
DB_MAX_LIFETIME=30
DB_DEBUG=true
# 多数据库示例（config/config.example.yaml 的 log 连接；留空表示不启用该连接）
#   connections 下的键名即连接名，环境变量为 DB_<大写键名>_*
DB_LOG_TYPE=mysql
DB_LOG_DSN=
DB_LOG_PREFIX=
DB_LOG_SINGULAR=true
DB_LOG_MAX_IDLE=10
DB_LOG_MAX_OPEN=10
DB_LOG_MAX_LIFETIME=30
DB_LOG_DEBUG=false

# ---- 登录认证 ----
AUTH_ENABLED=true
AUTH_TOKEN_EXPIRE=720
AUTH_MAX_RETRY=5
AUTH_LOCK_TIME=10
AUTH_PERMISSION_ENABLED=false

# ---- 图形验证码 ----
CAPTCHA_ENABLED=false
CAPTCHA_LENGTH=4
CAPTCHA_EXPIRE=120

# ---- 基础数据初始化（仅当对应表为空时写入） ----
SEED_ENABLED=false

# ---- 定时任务调度 ----
JOB_ENABLED=true
JOB_LOG_RETAIN_DAYS=30

# ---- 数据权限 ----
DATA_SCOPE_ENABLED=true

# ---- 文件存储（本地目录 / MinIO / RustFS / 腾讯云 COS / 阿里云 OSS） ----
# 是否启用（关闭时 s3.New()/s3.Default() 返回 ErrDisabled，上传入口应自行降级）
S3_ENABLED=false
# 存储驱动：local 本地目录（默认）/ minio / rustfs / cos / oss
S3_DRIVER=local
# 对象访问地址公共前缀（CDN / 反向代理域名），留空各后端使用自身默认值
S3_PUBLIC_BASE_URL=
# 本地目录后端：上传目录（容器内需可写）+ 对外访问前缀（服务启动时自动挂静态路由 /uploads -> 该目录）
S3_LOCAL_DIR=runtime/uploads
S3_LOCAL_URL_PREFIX=/uploads
# minio 后端（S3 协议）
S3_MINIO_ENDPOINT=127.0.0.1:9000
S3_MINIO_ACCESS_KEY=
S3_MINIO_SECRET_KEY=
S3_MINIO_BUCKET=admintpl
# 区域，留空自动向服务端查询
S3_MINIO_REGION=
S3_MINIO_SECURE=false
S3_MINIO_PATH_STYLE=false
# rustfs 后端（S3 协议，默认路径风格寻址 + us-east-1）
S3_RUSTFS_ENDPOINT=127.0.0.1:9000
S3_RUSTFS_ACCESS_KEY=
S3_RUSTFS_SECRET_KEY=
S3_RUSTFS_BUCKET=admintpl
S3_RUSTFS_REGION=us-east-1
S3_RUSTFS_SECURE=false
S3_RUSTFS_PATH_STYLE=true
# 腾讯云 cos 后端（bucket-url 优先；留空则用 bucket + region 拼接 https://<bucket>.cos.<region>.myqcloud.com）
S3_COS_BUCKET_URL=
S3_COS_BUCKET=
S3_COS_REGION=
S3_COS_SECRET_ID=
S3_COS_SECRET_KEY=
# 自定义访问域名（CDN），留空使用 bucket-url
S3_COS_DOMAIN=
# 阿里云 oss 后端
S3_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
S3_OSS_ACCESS_KEY_ID=
S3_OSS_ACCESS_KEY_SECRET=
S3_OSS_BUCKET=admintpl
# 自定义访问域名（CDN），留空使用 https://<bucket>.<endpoint>
S3_OSS_DOMAIN=

# ---- 参数 / 字典缓存 ----
# 是否启用缓存（关闭后每次查询回源数据库，仅建议排查问题时使用）
CACHE_ENABLED=true
# 后端：file 本地文件（默认）/ memory 进程内内存 / memcache / redis
CACHE_DRIVER=file
# 键前缀（多环境共用一个 memcache/redis 时用于隔离；实际键：前缀+缓存名+业务键）
CACHE_PREFIX=admintpl

# 本地文件后端（driver=file）
# 数据目录（文件 cache.gob，容器内需可写；K8s 建议挂载 emptyDir/PVC）
CACHE_FILE_DIR=runtime/cache
# 落盘间隔（秒）；进程收到 SIGTERM/SIGINT 时立即落盘
CACHE_FILE_FLUSH_INTERVAL=5

# memcache 后端（driver=memcache）
# 节点列表，多个以英文逗号分隔
CACHE_MEMCACHE_SERVERS=127.0.0.1:11211
# 连接与读写超时（秒）
CACHE_MEMCACHE_TIMEOUT=1

# redis 后端（driver=redis）
# 部署模式：standalone 单机 / master-slave 主从 / sentinel 哨兵 / cluster 集群
CACHE_REDIS_MODE=standalone
# 单机地址；主从/哨兵未配节点列表时作为主节点/哨兵地址
CACHE_REDIS_ADDR=127.0.0.1:6379
# 主从模式节点列表（主节点在前，逗号分隔），如 10.0.0.1:6379,10.0.0.2:6379
CACHE_REDIS_ADDRS=
# 集群模式节点列表（逗号分隔），如 10.0.0.1:6379,10.0.0.2:6379,10.0.0.3:6379
CACHE_REDIS_CLUSTER_ADDRS=
# 哨兵模式：主节点名 + 哨兵节点列表（逗号分隔）
CACHE_REDIS_MASTER_NAME=mymaster
CACHE_REDIS_SENTINEL_ADDRS=
# 哨兵自身密码（哨兵未开认证时留空）
CACHE_REDIS_SENTINEL_PASSWORD=
# redis 6+ ACL 用户名（未启用 ACL 时留空）
CACHE_REDIS_USERNAME=
# redis 密码（可用 ENC(...) 密文）
CACHE_REDIS_PASSWORD=
# 逻辑库编号（单机/主从/哨兵有效，集群固定 0）
CACHE_REDIS_DB=0
# 连接与读写超时（秒）
CACHE_REDIS_TIMEOUT=1
# 连接池大小
CACHE_REDIS_POOL_SIZE=10

# ---- 代码生成 ----
GEN_PACKAGE_NAME=github.com/bluefroog/admintpl
GEN_MODULE_NAME=system
GEN_AUTHOR=bluefrog
GEN_AUTO_REMOVE_PRE=true
GEN_TABLE_PREFIX=sys_
